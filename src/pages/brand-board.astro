<BaseLayout
	title="Brand Board | PlayerStall Visual Specimens"
	description="Internal visual board of PlayerStall logo, fonts, letter-spacing, colors, and button styles, live CSS specimens from the current site."
	headerBlack={true}
>
	<Fragment slot="head">
		<meta name="robots" content="noindex, nofollow" />
		<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Yantramanav:wght@400;500;700&display=swap" rel="stylesheet" />
	</Fragment>
	<main class="bb">
		<header class="bb-hero">
			<div class="bb-hero-inner">
				<p class="bb-kicker">Internal reference · not in main nav</p>
				<h1 class="bb-page-title">PlayerStall brand board</h1>
				<p class="bb-lede">
					Live specimens from the current website. Visual on the left, exact specs on the right.
					Open this page at <code>/brand-board</code>. Full written audit: <code>PLAYERSTALL-BRAND.md</code>.
				</p>
				<p class="bb-count">{specimens.length} examples</p>
			</div>
		</header>

		<div class="bb-list">
			{specimens.map((s) => (
				<article class="bb-row" id={`specimen-${s.id}`}>
					<div class="bb-visual" data-visual={s.visual} aria-hidden="true">
						{s.visual === 'logo-dark' && (
							<div class="bb-panel bb-panel--light">
								<span class="bb-logo bb-logo--dark">PLAYERSTALL</span>
							</div>
						)}
						{s.visual === 'logo-light' && (
							<div class="bb-panel bb-panel--dark">
								<span class="bb-logo bb-logo--light">PLAYERSTALL</span>
							</div>
						)}
						{s.visual === 'og-logo' && (
							<div class="bb-panel bb-panel--light bb-panel--center">
								<img
									src="https://playerstall.b-cdn.net/images/logoblack2.png"
									alt="PlayerStall logoblack2.png"
									class="bb-og-img"
									width="220"
									height="220"
									loading="lazy"
								/>
							</div>
						)}
						{s.visual === 'nav-links' && (
							<div class="bb-panel bb-panel--dark bb-panel--center">
								<nav class="bb-nav-sample" aria-label="Sample nav">
									<span>HOME</span>
									<span>SHOP</span>
									<span>GALLERY</span>
									<span>BLOG</span>
								</nav>
							</div>
						)}
						{s.visual === 'nav-dropdown' && (
							<div class="bb-panel bb-panel--light bb-panel--center">
								<div class="bb-dropdown-sample">
									<span>Football</span>
									<span class="is-hover">Hockey</span>
									<span>Basketball</span>
								</div>
							</div>
						)}
						{s.visual === 'follow-us' && (
							<div class="bb-panel bb-panel--black bb-panel--center">
								<span class="bb-follow">FOLLOW US:</span>
							</div>
						)}
						{s.visual === 'social-icons' && (
							<div class="bb-social-demo">
								<div class="bb-social-row bb-social-row--top">
									<span class="bb-social-label">Top bar</span>
									<span class="bb-follow">FOLLOW US:</span>
									<div class="bb-social-links bb-social-links--top">
										<span class="bb-social-icon" aria-label="Instagram" title="Instagram">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" set:html={iconIg} />
										</span>
										<span class="bb-social-icon" aria-label="LinkedIn" title="LinkedIn">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" set:html={iconLi} />
										</span>
										<span class="bb-social-icon is-hover" aria-label="X" title="X (hover)">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" set:html={iconX} />
										</span>
									</div>
								</div>
								<div class="bb-social-row bb-social-row--footer">
									<span class="bb-social-label">Footer</span>
									<div class="bb-social-links bb-social-links--footer">
