             cursor:pointer; transition:all .15s; }
  .ps-fbtn:hover { border-color:#b9b9b9; color:var(--ink); }
  .ps-fbtn.is-on { background:var(--ink); color:#fff; border-color:var(--ink); }
  .ps-count { font-size:13px; color:var(--muted); margin:22px 0 20px; }
  .ps-count:empty { margin:0; }
  /* One section only, so its heading would just repeat the page title. Kept in
     the markup for screen readers and the filter script. */
  .ps-hidden-head { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }

  /* One locker per line */
  .ps-row { display:grid; grid-template-columns:112px 190px 1fr 190px; gap:18px; align-items:start;
            border:1px solid var(--line); border-top:none; padding:20px 22px; background:#fff; }
  .ps-row:first-of-type { border-top:1px solid var(--line); }
  .ps-row:hover { background:#fcfcfb; }
  .ps-row.is-hidden { display:none; }
  /* All the width photos share one canvas with the locker centred, so a wider
     locker simply fills more of it - the picture shows the real width. */
  .ps-row-pic { height:170px; background:#f7f7f7; display:flex; align-items:center; justify-content:center; }
  .ps-row-pic img { width:100%; height:170px; object-fit:contain; }
  .ps-nophoto { color:var(--muted); font-size:12px; text-align:center; }
  .ps-rtitle { font-family:'Oswald'; font-size:19px; font-weight:600; text-transform:uppercase; margin:0 0 3px; line-height:1.25; }
  .ps-rtitle a { color:var(--ink); text-decoration:none; } .ps-rtitle a:hover { opacity:.65; }
  .ps-rmeta { font-size:14px; color:#333; }
  .ps-rdims { font-size:12px; color:var(--muted); margin-bottom:9px; }
  .ps-badge { display:inline-block; font-family:'Oswald'; font-size:11px; font-weight:600; letter-spacing:.08em;
              text-transform:uppercase; padding:5px 10px; color:#fff; }
  .ps-badge--in { background:var(--green); } .ps-badge--soon { background:var(--amber); }
  .ps-row-opts { display:grid; grid-template-columns:196px 196px 1fr; gap:18px; align-items:start; }
  .ps-optgroup { min-width:0; }
  .ps-optlabel { font-family:'Oswald'; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.09em;
                 color:var(--muted); margin-bottom:7px; }
  .ps-optlabel-hint { font-weight:400; text-transform:none; letter-spacing:0; color:var(--muted); }
  .ps-opt { display:block; cursor:pointer; margin-bottom:5px; width:100%; }
  .ps-opt input { position:absolute; opacity:0; pointer-events:none; }
  .ps-opt-in { display:flex; align-items:center; gap:9px; padding:7px 10px 7px 8px; border:1px solid var(--line);
               border-radius:3px; background:#fff; transition:border-color .15s, background .15s; }
  .ps-opt-in:hover { border-color:#b5b5b5; background:#fcfcfc; }
  .ps-opt-in img { width:34px; height:28px; object-fit:cover; background:#f4f4f2; border-radius:2px; flex:none; }
  .ps-opt-name { font-size:13px; flex:1; line-height:1.25; min-width:0; }
  .ps-opt-price { font-family:'Oswald'; font-weight:600; font-size:12px; color:var(--muted); white-space:nowrap; }
  .ps-opt-price--add { color:var(--green); }
  /* a visible tick or dot, so it reads as something you press */
  .ps-mark { width:15px; height:15px; flex:none; border:1.5px solid #bdbdbd; background:#fff; position:relative; }
  .ps-mark--radio { border-radius:50%; }
  .ps-mark--check { border-radius:3px; }
  .ps-opt input:checked + .ps-opt-in { border-color:var(--ink); background:#fafafa; }
  .ps-opt input:checked + .ps-opt-in .ps-mark { border-color:var(--ink); background:var(--ink); }
  .ps-opt input:checked + .ps-opt-in .ps-mark--radio::after { content:''; position:absolute; inset:3.5px; border-radius:50%; background:#fff; }
  .ps-opt input:checked + .ps-opt-in .ps-mark--check::after { content:''; position:absolute; left:4px; top:1px; width:4px; height:8px;
               border:solid #fff; border-width:0 2px 2px 0; transform:rotate(45deg); }
  .ps-opt input:focus-visible + .ps-opt-in { outline:2px solid #4a90d9; outline-offset:2px; }
  .ps-build { font-size:12px; color:var(--muted); margin-top:7px; }
  .ps-optgroup--small .ps-opt { width:100%; max-width:178px; margin-bottom:4px; }
  .ps-opt--small .ps-opt-in { padding:5px 10px 5px 8px; }
  .ps-opt--small .ps-opt-name { font-size:12.5px; }
  .ps-small { color:var(--muted); }
  .ps-included { font-size:12px; color:#555; margin:0; max-width:230px; }
  .ps-row-price { text-align:right; }
  .ps-price { font-family:'Oswald'; font-size:26px; font-weight:600; display:block; line-height:1.1; }
  .ps-price-note { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; }
  .ps-price-note.ps-promo { color:var(--green); font-family:'Oswald'; font-weight:600; }
  .ps-sum { font-size:11.5px; color:#555; margin:9px 0 0; }
  .ps-rlinks { margin-top:12px; display:flex; gap:12px; justify-content:flex-end; align-items:center; }
  /* The label must never vanish into the black box: the selector is specific
     enough to beat the site's global link colour, and the font falls back to
     a narrow system face if Oswald has not loaded yet. */
  .ps-rlinks a.ps-btn { font-family:'Oswald','Arial Narrow',Arial,sans-serif; font-size:11px; font-weight:600;
            letter-spacing:.08em; text-transform:uppercase; background:var(--ink); color:#fff;
            padding:9px 16px; text-decoration:none; display:inline-block; }
  .ps-rlinks a.ps-btn:hover, .ps-rlinks a.ps-btn:visited, .ps-rlinks a.ps-btn:focus { color:#fff; }
  .ps-rlinks a.ps-btn:hover { background:#333; }
  .ps-link { font-size:12px; color:var(--ink); } .ps-link--off { color:var(--muted); }
  .ps-empty { color:var(--muted); font-style:italic; padding:20px 0 40px; }
  footer { border-top:1px solid var(--line); margin-top:60px; padding:26px 0 60px; font-size:12px; color:var(--muted); }

  /* Nothing may push the page sideways on a phone. Note: .ps-wrap is left out
 on purpose, a blanket max-width:100% here would override its 1300px
     centring and throw the content against the edges of a wide screen. */
  .ps-row, .ps-row-opts, .ps-optgroup { min-width:0; max-width:100%; }
  img { max-width:100%; }

  /* Tablet: the option groups stop being three fixed columns. */
  @media (max-width:1100px) {
    .ps-row { grid-template-columns:104px 1fr; gap:16px; }
    .ps-row-opts { grid-column:1 / -1; grid-template-columns:repeat(auto-fit, minmax(170px, 1fr)); gap:16px; }
    .ps-row-price { grid-column:1 / -1; text-align:left; border-top:1px solid var(--line); padding-top:14px; }
    .ps-rlinks { justify-content:flex-start; }
    .ps-filters { position:static; gap:16px; }
    .ps-opt, .ps-optgroup--small .ps-opt { width:100%; max-width:none; }
  }

  /* Phone: one column throughout, and the filters scroll sideways in their
     own strip instead of forcing the page wide. */
  @media (max-width:720px) {
    .ps-wrap { padding:0 16px; }
    .ps-head { padding:22px 0 4px; }
    .ps-hero-section { min-height:230px; padding:0 0 34px; }
    .ps-hero-inner { padding:0 16px; }
    .ps-hero-crumb { margin-bottom:14px; }
    .ps-hero-title { font-size:28px; }
    .ps-sub { margin-top:26px; }
    h1 { font-size:30px; line-height:1.1; }
    .ps-lede { font-size:16px; }
    .ps-sub { font-size:11px; letter-spacing:.06em; }
    .ps-filters { display:block; border-top-width:1px; padding:14px 0 10px; }
    .ps-fgroup { display:block; margin-bottom:10px; }
    .ps-flabel { display:block; margin-bottom:6px; }
    .ps-fbtns { flex-wrap:nowrap; overflow-x:auto; -webkit-overflow-scrolling:touch;
                scrollbar-width:none; padding-bottom:2px; }
    .ps-fbtns::-webkit-scrollbar { display:none; }
    .ps-fbtn { flex:0 0 auto; }

    .ps-row { grid-template-columns:92px 1fr; gap:14px; padding:16px 14px; }
    .ps-row-pic { height:120px; }
    .ps-row-pic img { height:120px; }
    .ps-rtitle { font-size:17px; }
    .ps-row-opts { grid-template-columns:1fr; gap:14px; }
    .ps-opt-in { padding:9px 11px 9px 9px; }   /* a bigger tap target */
    .ps-opt-name { font-size:13.5px; }
    .ps-price { font-size:24px; }
    .ps-row-price { display:flex; flex-wrap:wrap; align-items:baseline; gap:6px 10px; }
    .ps-build, .ps-sum { width:100%; margin-top:2px; }
    .ps-rlinks { width:100%; margin-top:10px; }
    .ps-rlinks a.ps-btn { padding:11px 20px; }
  }

</style>
</BaseLayout>
