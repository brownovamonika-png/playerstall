<script>
  // --- Price follows the options ------------------------------------------
  document.addEventListener('change', (e) => {
    const id = e.target.dataset?.card
    if (!id) return
    const card = document.getElementById('card-' + id)
    const base = Number(card.dataset.base) || 0
    const front = Number(card.querySelector('input[name="front-' + id + '"]:checked')?.value || 0)
    const lockEl = card.querySelector('input[name="lock-' + id + '"]')
    const lock = lockEl?.checked ? Number(lockEl.value) : 0
    const accs = [...card.querySelectorAll('input[name="acc-' + id + '"]:checked')]
    const accTotal = accs.reduce((sum, el) => sum + Number(el.value), 0)
    const money = (n) => '$' + n.toLocaleString('en-CA')
    card.querySelector('[data-price-for="' + id + '"]').textContent = money(base + front + lock + accTotal)
    const extras = []
    if (front) extras.push('vented front')
    if (lock) extras.push('lock box')
    accs.forEach((el) => extras.push(el.dataset.acc))
    const note = card.querySelector('[data-pricenote-for="' + id + '"]')
    if (!note.classList.contains('ps-promo'))
      note.textContent = extras.length ? 'with ' + extras.join(' + ') : 'as shown'
    // Spell the sum out, so it is obvious what the options did to the price.
    const build = card.querySelector('[data-build-for="' + id + '"]')
    if (build) {
      const parts = [money(base) + ' locker']
      if (front) parts.push(money(front) + ' vented front')
      if (lock) parts.push(money(lock) + ' lock box')
      accs.forEach((el) => parts.push(money(Number(el.value)) + ' ' + el.dataset.acc))
      build.textContent = parts.join('  +  ')
    }
  })

  // --- Filter by style / colour / width ------------------------------------
  const TOTAL = 363
  const picked = { style: '', color: '', width: '' }
  const rows = [...document.querySelectorAll('.ps-row')]
  function apply() {
    let shown = 0
    for (const r of rows) {
      const ok = (!picked.style || r.dataset.style === picked.style)
              && (!picked.color || r.dataset.color === picked.color)
              && (!picked.width || r.dataset.width === picked.width)
      r.classList.toggle('is-hidden', !ok)
      if (ok) shown++
    }
    // Hide a section heading when its whole list is filtered out.
    for (const [listId, hId] of [['list-ready', 'h-ready'], ['list-soon', 'h-soon']]) {
      const list = document.getElementById(listId)
      if (!list) continue
      const any = [...list.querySelectorAll('.ps-row')].some((r) => !r.classList.contains('is-hidden'))
      const h = document.getElementById(hId)
      h.style.display = any ? '' : 'none'
      h.nextElementSibling.style.display = any ? '' : 'none'
      list.style.display = any ? '' : 'none'
    }
    const bits = [picked.style, picked.color, picked.width ? picked.width + '″' : ''].filter(Boolean)
    document.getElementById('ps-count').textContent = bits.length
      ? shown + ' of ' + rows.length + ' showing: ' + bits.join(', ')
      : ''
  }
  document.querySelectorAll('.ps-fbtn').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.filter
    picked[k] = b.dataset.value
    document.querySelectorAll('.ps-fbtn[data-filter="' + k + '"]').forEach((o) => o.classList.toggle('is-on', o === b))
    apply()
  }))
  apply()
</script>

<script define:vars={{ feed }}>
  // The page ships with the counts baked in at build time. If a live feed is
  // configured it refreshes them on load, so a sold locker drops off without
  // anyone rebuilding the site.
  if (feed) {
    fetch(feed).then((r) => r.ok ? r.json() : null).then((data) => {
      if (!data?.lockers) return;
      for (const row of document.querySelectorAll('.ps-row')) {
        const m = data.lockers.find((l) =>
          String(l.width) === row.dataset.width && l.colour === row.dataset.color);
        const badge = row.querySelector('.ps-badge');
        if (!m) { row.remove(); continue; }
        if (badge) badge.textContent = m.available + ' in stock';
      }
    }).catch(() => {});
  }
</script>
